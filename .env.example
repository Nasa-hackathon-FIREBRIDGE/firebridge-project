NODE_ENV=development
PORT=3000
API_HOST=127.0.0.1
# shared for a fresh database; legacy only for the verified consolidated history.
PRISMA_MIGRATION_HISTORY=shared
APP_NAME=firebridge
LOG_LEVEL=info

DEFAULT_SCOPE_KEY=morocco
# Replace with a random secret of at least 32 characters; use the same value on all API replicas.
CURSOR_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional: set a distinct random token (32+ characters) to enable Phase 5 administration.
# Send it as Authorization: Bearer <token>. Without it administrative ingestion routes return 503.
# INGESTION_ADMIN_TOKEN=
MAX_AOI_VERTICES=5000
MAX_AOI_AREA_KM2=250000
MAX_EVIDENCE_CELL_DAYS=2000
MAX_POINTS_PER_PAGE=5000

DATABASE_URL=postgresql://firebridge:firebridge@localhost:5432/firebridge
REDIS_URL=redis://localhost:6379
# If 6379 is occupied, change REDIS_PORT and the port in REDIS_URL together.
REDIS_PORT=6379

# Cryptographic and security settings
CORS_ORIGINS=http://localhost:5173
PAGINATION_SECRET=firebridge-dev-secret-key-32-chars-long

# PostGIS and geospatial settings
POSTGIS_ENABLED=true

# External service configuration placeholders
SATELLITE_API_BASE_URL=https://example.com
WEATHER_API_BASE_URL=https://weather.example.com
AI_PROVIDER_API_KEY=replace-me

# Phase 4: shared absolute storage path on multi-process deployments.
# Default: <repository>/.data/exports; Docker Compose mounts a shared volume.
# EXPORT_STORAGE_DIR=C:/firebridge-exports
TILE_MAX_ZOOM=18
TILE_CACHE_SECONDS=60
TILE_QUERY_TIMEOUT_MS=5000
TILE_MAX_BYTES=2097152
TILE_REQUESTS_PER_MINUTE=120
EXPORT_REQUESTS_PER_MINUTE=5
DOWNLOAD_REQUESTS_PER_MINUTE=30
EXPORT_MAX_ACTIVE=2
EXPORT_MAX_PER_HOUR=10
EXPORT_MAX_ROWS=1000000
EXPORT_MAX_BYTES=268435456
EXPORT_MAX_DURATION_SECONDS=300
EXPORT_RETENTION_SECONDS=86400
EXPORT_BATCH_SIZE=1000
EXPORT_WORKER_CONCURRENCY=2
EXPORT_CLEANUP_INTERVAL_SECONDS=60

# Integration tests require explicit isolated infrastructure; never use the URLs above.
# TEST_DATABASE_URL=postgresql://test:test@localhost:5432/firebridge_test
# TEST_REDIS_URL=redis://localhost:6379/15

# WORKER_AUTOSTART=true

# Worker reliability. Redis producers fail commands after 2500ms; blocking workers reconnect.
OUTBOX_MAX_ATTEMPTS=10
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_LEASE_SECONDS=60
ANALYSIS_WORKER_CONCURRENCY=5
# Recovery is opt-in. Choose a deployment cutoff that excludes historical jobs.
RECOVERY_ENABLED=false
# RECOVERY_CREATED_AFTER=2026-11-02T00:00:00Z
RECOVERY_INTERVAL_MS=30000
RECOVERY_STALE_SECONDS=120
RECOVERY_BATCH_SIZE=20
RECOVERY_MAX_ATTEMPTS=5
