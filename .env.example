NODE_ENV=development
PORT=3000
APP_NAME=firebridge
LOG_LEVEL=info

DEFAULT_SCOPE_KEY=morocco
# Replace with a random secret of at least 32 characters; use the same value on all API replicas.
CURSOR_SECRET=replace-with-a-random-secret-at-least-32-characters
MAX_AOI_VERTICES=5000
MAX_AOI_AREA_KM2=250000
MAX_EVIDENCE_CELL_DAYS=2000
MAX_POINTS_PER_PAGE=5000

DATABASE_URL=postgresql://firebridge:firebridge@localhost:5432/firebridge
REDIS_URL=redis://localhost:6379

# PostGIS and geospatial settings
POSTGIS_ENABLED=true

# External service configuration placeholders
SATELLITE_API_BASE_URL=https://example.com
WEATHER_API_BASE_URL=https://weather.example.com
AI_PROVIDER_API_KEY=replace-me
