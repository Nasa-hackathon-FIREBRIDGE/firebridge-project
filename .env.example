# Public API base URL, including the existing version prefix. Defaults to this URL when absent.
VITE_API_URL=http://localhost:3000/api/v1

# Optional: MapLibre-compatible style JSON URL. Takes precedence over VITE_BASEMAP_PROVIDER.
# Do not commit provider keys.
VITE_MAP_STYLE_URL=

# Built-in provider: nasa-gibs (default), esri-world-imagery, or schematic (offline).
# NASA Blue Marble is an archival satellite composite, not current fire imagery.
# NASA GIBS needs no key. Esri requires appropriate ArcGIS licensing; see README.
# Explicit style URLs above take precedence. VITE_* URLs are public browser configuration;
# use only browser-safe, origin-restricted provider tokens, never private credentials.
VITE_BASEMAP_PROVIDER=nasa-gibs
