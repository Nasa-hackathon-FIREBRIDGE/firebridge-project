# Public API base URL, including the existing version prefix. Defaults to this URL when absent.
VITE_API_URL=http://localhost:3000/api/v1

# Optional: MapLibre-compatible style JSON URL. Takes precedence over VITE_BASEMAP_PROVIDER.
# Do not commit provider keys.
VITE_MAP_STYLE_URL=

# Optional: built-in raster provider. Supported value: esri-world-imagery
# Review Esri's terms (and use an API key for public/commercial use) before enabling. See README.
# Leave both variables unset for the offline schematic view (no external requests).
VITE_BASEMAP_PROVIDER=
