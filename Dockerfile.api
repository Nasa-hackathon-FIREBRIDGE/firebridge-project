FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
COPY packages ./packages

RUN npm install

COPY . .

RUN DATABASE_URL="postgresql://postgres:postgres@localhost:5432/firebridge?schema=firebridge" npm run build --workspace @firebridge/api

EXPOSE 3000

CMD ["npm", "run", "start", "--workspace", "@firebridge/api"]
