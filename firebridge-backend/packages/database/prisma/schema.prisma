// SQL migrations preserve PostGIS types, CHECK constraints, generated columns and partial indexes.
// Prisma maps migrated metadata; spatial reads/writes use parameterized SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["firebridge", "public"]
}

model Source {
  id                                                   String            @id
  name                                                 String
  provider                                             String
  kind                                                 String
  platform                                             String?
  instrument                                           String?
  product                                              String
  collection                                           String
  processingStream                                     String            @map("processing_stream")
  documentationUrl                                     String            @map("documentation_url")
  citation                                             String
  licenseInfo                                          String            @map("license_info")
  nativeResolutionM                                    Float?            @map("native_resolution_m")
  schemaVersion                                        String            @map("schema_version")
  metadata                                             Json              @default("{}")
  assets                                               Asset[]
  detections                                           Detection[]
  feedSources                                          FeedSource[]
  modelVersionsModelVersionsReferenceSourceIdTosources ModelVersion[]    @relation("model_versions_reference_source_idTosources")
  modelVersionsModelVersionsSourceIdTosources          ModelVersion[]    @relation("model_versions_source_idTosources")
  observations                                         Observation[]
  weatherLocations                                     WeatherLocation[]
  weatherSummaries                                     WeatherSummary[]

  @@index([kind])
  @@index([provider])
  @@map("sources")
  @@schema("firebridge")
}

model Area {
  id                     String                  @id @db.Uuid
  name                   String
  version                String
  geom                   Unsupported("geometry")
  geometrySha256         String                  @map("geometry_sha256")
  displayTimezone        String                  @map("display_timezone")
  provenance             String
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  analyses               Analysis[]
  areaCells              AreaCell[]
  ingestionSubscriptions IngestionSubscription[]

  @@unique([geometrySha256, version])
  @@index([geom], map: "areas_geom_gist", type: Gist)
  @@map("areas")
  @@schema("firebridge")
}

model Asset {
  id                 String                   @id @db.Uuid
  sourceId           String                   @map("source_id")
  nativeKey          String                   @map("native_key")
  revision           String
  sourceUrl          String                   @map("source_url")
  storageUri         String                   @map("storage_uri")
  sha256             String
  byteSize           BigInt                   @map("byte_size")
  timeStart          DateTime?                @map("time_start") @db.Timestamptz(6)
  timeEnd            DateTime?                @map("time_end") @db.Timestamptz(6)
  footprint          Unsupported("geometry")?
  retrievedAt        DateTime                 @map("retrieved_at") @db.Timestamptz(6)
  validationStatus   String                   @map("validation_status")
  metadata           Json                     @default("{}")
  sources            Source                   @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  detections         Detection[]
  fetchAssets        FetchAsset[]
  grids              Grid[]
  newsReports        NewsReport[]
  observationAssets  ObservationAsset[]
  qualityIssues      QualityIssue[]
  releaseAssets      ReleaseAsset[]
  sourceAvailability SourceAvailability[]
  weatherValues      WeatherValue[]

  @@unique([id, sourceId])
  @@unique([sourceId, nativeKey, revision, sha256])
  @@index([footprint], map: "assets_footprint_gist", type: Gist)
  @@map("assets")
  @@schema("firebridge")
}

model DataPartition {
  id                                                                         String                @id @db.Uuid
  pipelineRunId                                                              String                @map("pipeline_run_id") @db.Uuid
  kind                                                                       String
  seriesKey                                                                  String                @map("series_key")
  partitionKey                                                               String                @map("partition_key")
  supportSpec                                                                Json                  @map("support_spec")
  storageUri                                                                 String                @map("storage_uri")
  sha256                                                                     String
  inputManifestUri                                                           String                @map("input_manifest_uri")
  schemaVersion                                                              String                @map("schema_version")
  rowCount                                                                   BigInt                @map("row_count")
  servingComplete                                                            Boolean               @map("serving_complete")
  validationStatus                                                           String                @map("validation_status")
  createdAt                                                                  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  pipelineRuns                                                               PipelineRun           @relation(fields: [pipelineRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partitionDependenciesPartitionDependenciesInputPartitionIdTodataPartitions PartitionDependency[] @relation("partition_dependencies_input_partition_idTodata_partitions")
  partitionDependenciesPartitionDependenciesPartitionIdTodataPartitions      PartitionDependency[] @relation("partition_dependencies_partition_idTodata_partitions")
  partitionDetections                                                        PartitionDetection[]
  releasePartitions                                                          ReleasePartition[]

  @@unique([id, seriesKey, partitionKey])
  @@unique([seriesKey, partitionKey, sha256])
  @@index([seriesKey, partitionKey, createdAt(sort: Desc)], map: "partitions_key")
  @@map("data_partitions")
  @@schema("firebridge")
}

model DataRelease {
  id                  String              @id @db.Uuid
  name                String              @unique
  status              String
  stream              String
  codeVersion         String              @map("code_version")
  config              Json
  configSha256        String              @map("config_sha256")
  manifestUri         String              @map("manifest_uri")
  parentReleaseId     String?             @map("parent_release_id") @db.Uuid
  datasetKind         String              @map("dataset_kind")
  scopeKey            String              @map("scope_key")
  observationCutoff   DateTime            @map("observation_cutoff") @db.Timestamptz(6)
  validationReportUri String?             @map("validation_report_uri")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt         DateTime?           @map("published_at") @db.Timestamptz(6)
  analyses            Analysis[]
  analysisComponents  AnalysisComponent[]
  dailyActivity       DailyActivity[]
  dataReleases        DataRelease?        @relation("data_releasesTodata_releases", fields: [parentReleaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childReleases       DataRelease[]       @relation("data_releasesTodata_releases")
  evaluations         Evaluation[]
  featureSets         FeatureSet[]
  matchedPairs        MatchedPair[]
  observations        Observation[]
  pipelineRuns        PipelineRun[]
  predictions         Prediction[]
  releaseAliases      ReleaseAlias[]
  releaseAssets       ReleaseAsset[]
  changesFrom         ReleaseChange[]     @relation("release_changes_from_release_idTodata_releases")
  changesTo           ReleaseChange[]     @relation("release_changes_to_release_idTodata_releases")
  releasePartitions   ReleasePartition[]

  @@index([scopeKey, status], map: "data_releases_scope_status")
  @@map("data_releases")
  @@schema("firebridge")
}

model FeedSource {
  feedId             String               @map("feed_id")
  sourceId           String               @map("source_id")
  selector           Json
  ingestionFeeds     IngestionFeed        @relation(fields: [feedId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sources            Source               @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourceAvailability SourceAvailability[]

  @@id([feedId, sourceId])
  @@map("feed_sources")
  @@schema("firebridge")
}

model Grid {
  id               String                  @id
  version          String
  projectionSrid   Int                     @map("projection_srid")
  cellSizeM        Float                   @map("cell_size_m")
  originXM         Float                   @map("origin_x_m")
  originYM         Float                   @map("origin_y_m")
  supportedExtent  Unsupported("geometry") @map("supported_extent")
  landMaskAssetId  String                  @map("land_mask_asset_id") @db.Uuid
  constructionSpec Json                    @map("construction_spec")
  analyses         Analysis[]
  gridCells        GridCell[]
  assets           Asset                   @relation(fields: [landMaskAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("grids")
  @@schema("firebridge")
}

model IngestionFeed {
  id                     String                  @id
  provider               String
  adapter                String
  adapterVersion         String                  @map("adapter_version")
  endpointTemplate       String                  @map("endpoint_template")
  credentialRef          String?                 @map("credential_ref")
  rateLimitGroup         String                  @map("rate_limit_group")
  capabilitySpec         Json                    @map("capability_spec")
  state                  String
  verifiedAt             DateTime?               @map("verified_at") @db.Timestamptz(6)
  feedSources            FeedSource[]
  ingestionSubscriptions IngestionSubscription[]

  @@map("ingestion_feeds")
  @@schema("firebridge")
}

model IngestionSubscription {
  id                   String                @id @db.Uuid
  feedId               String                @map("feed_id")
  areaId               String                @map("area_id") @db.Uuid
  scopeKey             String                @map("scope_key")
  mode                 String
  intervalSeconds      Int                   @map("interval_seconds")
  overlapSeconds       Int                   @map("overlap_seconds")
  historyStart         DateTime              @map("history_start") @db.Timestamptz(6)
  fixedEndExclusive    DateTime?             @map("fixed_end_exclusive") @db.Timestamptz(6)
  requestConfig        Json                  @map("request_config")
  configSha256         String                @map("config_sha256")
  enabled              Boolean               @default(false)
  nextDueAt            DateTime?             @map("next_due_at") @db.Timestamptz(6)
  leaseOwner           String?               @map("lease_owner")
  leaseExpiresAt       DateTime?             @map("lease_expires_at") @db.Timestamptz(6)
  fetchRuns            FetchRun[]
  ingestionCheckpoints IngestionCheckpoint[]
  ingestionGaps        IngestionGap[]
  areas                Area                  @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ingestionFeeds       IngestionFeed         @relation(fields: [feedId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([feedId, scopeKey, mode, configSha256])
  @@map("ingestion_subscriptions")
  @@schema("firebridge")
}

model MetricDefinition {
  id            String          @id
  version       String
  unit          String
  family        String
  description   String
  definition    Json
  requiresMasks Boolean         @map("requires_masks")
  requiresModel Boolean         @map("requires_model")
  analyses      Analysis[]
  dailyActivity DailyActivity[]

  @@map("metric_definitions")
  @@schema("firebridge")
}

model PipelineRun {
  id                String          @id @db.Uuid
  releaseId         String?         @map("release_id") @db.Uuid
  stage             String
  idempotencyKey    String          @unique @map("idempotency_key")
  status            String
  codeVersion       String          @map("code_version")
  config            Json
  inputManifestUri  String          @map("input_manifest_uri")
  outputManifestUri String?         @map("output_manifest_uri")
  startedAt         DateTime?       @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime?       @map("finished_at") @db.Timestamptz(6)
  errorCode         String?         @map("error_code")
  logUri            String?         @map("log_uri")
  dataPartitions    DataPartition[]
  fetchRuns         FetchRun[]
  dataReleases      DataRelease?    @relation(fields: [releaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  qualityIssues     QualityIssue[]

  @@map("pipeline_runs")
  @@schema("firebridge")
}

model ReleaseAlias {
  alias        String
  scopeKey     String      @map("scope_key")
  releaseId    String      @map("release_id") @db.Uuid
  generation   BigInt      @default(0)
  updatedAt    DateTime    @map("updated_at") @db.Timestamptz(6)
  dataReleases DataRelease @relation(fields: [releaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([alias, scopeKey])
  @@index([releaseId], map: "release_aliases_release")
  @@map("release_aliases")
  @@schema("firebridge")
}

model ReleaseAsset {
  releaseId    String      @map("release_id") @db.Uuid
  assetId      String      @map("asset_id") @db.Uuid
  role         String
  assets       Asset       @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dataReleases DataRelease @relation(fields: [releaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([releaseId, assetId, role])
  @@map("release_assets")
  @@schema("firebridge")
}

model ReleaseChange {
  id                   String                   @id @db.Uuid
  fromReleaseId        String                   @map("from_release_id") @db.Uuid
  toReleaseId          String                   @map("to_release_id") @db.Uuid
  seriesKey            String                   @map("series_key")
  affectedStart        DateTime                 @map("affected_start") @db.Timestamptz(6)
  affectedEndExclusive DateTime                 @map("affected_end_exclusive") @db.Timestamptz(6)
  affectedArea         Unsupported("geometry")? @map("affected_area")
  reason               String
  diffManifestUri      String                   @map("diff_manifest_uri")
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  fromRelease          DataRelease              @relation("release_changes_from_release_idTodata_releases", fields: [fromReleaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toRelease            DataRelease              @relation("release_changes_to_release_idTodata_releases", fields: [toReleaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([toReleaseId], map: "release_changes_to")
  @@map("release_changes")
  @@schema("firebridge")
}

model ReleasePartition {
  releaseId      String        @map("release_id") @db.Uuid
  seriesKey      String        @map("series_key")
  partitionKey   String        @map("partition_key")
  partitionId    String        @map("partition_id") @db.Uuid
  dataPartitions DataPartition @relation(fields: [partitionId, seriesKey, partitionKey], references: [id, seriesKey, partitionKey], onDelete: NoAction, onUpdate: NoAction)
  dataReleases   DataRelease   @relation(fields: [releaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([releaseId, seriesKey, partitionKey])
  @@map("release_partitions")
  @@schema("firebridge")
}

model SourceAvailability {
  feedId                String     @map("feed_id")
  sourceId              String     @map("source_id")
  checkedAt             DateTime   @map("checked_at") @db.Timestamptz(6)
  availableStart        DateTime?  @map("available_start") @db.Timestamptz(6)
  availableEndExclusive DateTime?  @map("available_end_exclusive") @db.Timestamptz(6)
  status                String
  evidenceAssetId       String?    @map("evidence_asset_id") @db.Uuid
  detail                Json
  assets                Asset?     @relation(fields: [evidenceAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feedSources           FeedSource @relation(fields: [feedId, sourceId], references: [feedId, sourceId], onDelete: NoAction, onUpdate: NoAction)

  @@id([feedId, sourceId, checkedAt])
  @@index([feedId, sourceId, checkedAt(sort: Desc)], map: "source_availability_recent")
  @@map("source_availability")
  @@schema("firebridge")
}

model HealthCheck {
  id        String   @id
  createdAt DateTime @default(now())
  status    String

  @@schema("public")
}

model SpatialReferenceSystem {
  srid      Int     @id
  authName  String? @map("auth_name") @db.VarChar(256)
  authSrid  Int?    @map("auth_srid")
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)

  @@map("spatial_ref_sys")
  @@ignore
  @@schema("public")
}

model AiExplanation {
  id                  String           @id @db.Uuid
  snapshotId          String           @map("snapshot_id") @db.Uuid
  language            String
  question            String
  provider            String
  modelId             String           @map("model_id")
  promptVersion       String           @map("prompt_version")
  toolContractVersion String           @map("tool_contract_version")
  outputJson          Json?            @map("output_json")
  status              String
  validationReport    Json?            @map("validation_report")
  toolTraceUri        String?          @map("tool_trace_uri")
  inputTokens         Int?             @map("input_tokens")
  outputTokens        Int?             @map("output_tokens")
  cacheKey            String           @unique @map("cache_key")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt         DateTime?        @map("completed_at") @db.Timestamptz(6)
  evidenceSnapshots   EvidenceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  apiJobs             ApiJob[]

  @@map("ai_explanations")
  @@schema("firebridge")
}

model Analysis {
  id                 String              @id @db.Uuid
  areaId             String              @map("area_id") @db.Uuid
  releaseId          String              @map("release_id") @db.Uuid
  startDate          DateTime            @map("start_date") @db.Date
  endDateExclusive   DateTime            @map("end_date_exclusive") @db.Date
  timeBasis          String              @map("time_basis")
  metricKey          String              @map("metric_key")
  gridId             String?             @map("grid_id")
  selectionPolicy    String              @map("selection_policy")
  weightingVersion   String              @map("weighting_version")
  baselineSpec       Json?               @map("baseline_spec")
  weatherPolicy      Json                @map("weather_policy")
  newsPolicy         Json                @map("news_policy")
  requestSpec        Json                @map("request_spec")
  cacheKey           String              @unique @map("cache_key")
  status             String
  errorCode          String?             @map("error_code")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt        DateTime?           @map("completed_at") @db.Timestamptz(6)
  areas              Area                @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grids              Grid?               @relation(fields: [gridId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  metricDefinitions  MetricDefinition    @relation(fields: [metricKey], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dataReleases       DataRelease         @relation(fields: [releaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  analysisComponents AnalysisComponent[]
  analysisEventLinks AnalysisEventLink[]
  apiJobs            ApiJob[]
  calendarPeriods    CalendarPeriod[]
  evidenceSnapshots  EvidenceSnapshot[]
  weatherSummaries   WeatherSummary[]

  @@map("analyses")
  @@schema("firebridge")
}

model AnalysisComponent {
  analysisId   String       @map("analysis_id") @db.Uuid
  component    String
  releaseId    String?      @map("release_id") @db.Uuid
  status       String
  reasons      Json         @default("[]")
  analyses     Analysis     @relation(fields: [analysisId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dataReleases DataRelease? @relation(fields: [releaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([analysisId, component])
  @@map("analysis_components")
  @@schema("firebridge")
}

model AnalysisEventLink {
  analysisId         String        @map("analysis_id") @db.Uuid
  eventId            String        @map("event_id") @db.Uuid
  relation           String
  matchMethodVersion String        @map("match_method_version")
  temporalMatch      Json          @map("temporal_match")
  spatialMatch       Json          @map("spatial_match")
  independence       String
  evidenceNote       String        @map("evidence_note")
  reviewedBy         String?       @map("reviewed_by")
  reviewedAt         DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  analyses           Analysis      @relation(fields: [analysisId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reportedEvents     ReportedEvent @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([analysisId, eventId, matchMethodVersion])
  @@map("analysis_event_links")
  @@schema("firebridge")
}

model ApiJob {
  explanationRequestKeys ExplanationRequestKey[]
  analysisRequestKeys    AnalysisRequestKey[]
  id                     String                  @id @db.Uuid
  kind                   String
  analysisId             String?                 @map("analysis_id") @db.Uuid
  explanationId          String?                 @map("explanation_id") @db.Uuid
  requestedBy            String?                 @map("requested_by") // Preserved legacy metadata; public workflows omit it.
  requestHash            String                  @map("request_hash")
  idempotencyKey         String                  @map("idempotency_key")
  requestSpec            Json                    @map("request_spec")
  status                 String
  attempt                Int                     @default(0)
  leaseExpiresAt         DateTime?               @map("lease_expires_at") @db.Timestamptz(6)
  progress               Json                    @default("{}")
  resultManifestUri      String?                 @map("result_manifest_uri")
  resultSha256           String?                 @map("result_sha256")
  resultByteSize         BigInt?                 @map("result_byte_size")
  expiresAt              DateTime?               @map("expires_at") @db.Timestamptz(6)
  errorCode              String?                 @map("error_code")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt            DateTime?               @map("completed_at") @db.Timestamptz(6)
  analyses               Analysis?               @relation(fields: [analysisId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  aiExplanations         AiExplanation?          @relation(fields: [explanationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([requestedBy, idempotencyKey])
  @@unique([idempotencyKey], map: "jobs_public_request_key")
  @@index([status, createdAt], map: "jobs_status")
  @@map("api_jobs")
  @@schema("firebridge")
}

model AreaCell {
  areaId            String   @map("area_id") @db.Uuid
  cellId            BigInt   @map("cell_id")
  overlapLandAreaM2 Float    @map("overlap_land_area_m2")
  weightingVersion  String   @map("weighting_version")
  areas             Area     @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gridCells         GridCell @relation(fields: [cellId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([areaId, cellId, weightingVersion])
  @@map("area_cells")
  @@schema("firebridge")
}

model CalendarPeriod {
  analysisId              String   @map("analysis_id") @db.Uuid
  periodStart             DateTime @map("period_start") @db.Date
  periodEndExclusive      DateTime @map("period_end_exclusive") @db.Date
  resolution              String
  responseNumeratorM2Days Float    @map("response_numerator_m2_days")
  eligibleLandM2Days      Float    @map("eligible_land_m2_days")
  possibleLandM2Days      Float    @map("possible_land_m2_days")
  responseValue           Float?   @default(dbgenerated("(response_numerator_m2_days / NULLIF(eligible_land_m2_days, (0)::double precision))")) @map("response_value")
  coverageFraction        Float?   @default(dbgenerated("(eligible_land_m2_days / possible_land_m2_days)")) @map("coverage_fraction")
  observedWeightFraction  Float?   @map("observed_weight_fraction")
  validCellDays           BigInt   @map("valid_cell_days")
  baselineYearCount       Int      @default(0) @map("baseline_year_count")
  seasonalPercentile      Float?   @map("seasonal_percentile")
  uncertainty             Json?
  status                  String
  reasons                 Json     @default("[]")
  analyses                Analysis @relation(fields: [analysisId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([analysisId, periodStart, resolution])
  @@map("calendar_periods")
  @@schema("firebridge")
}

model DailyActivity {
  releaseId         String           @map("release_id") @db.Uuid
  cellId            BigInt           @map("cell_id")
  reportingDate     DateTime         @map("reporting_date") @db.Date
  timeBasis         String           @map("time_basis")
  metricKey         String           @map("metric_key")
  selectionPolicy   String           @map("selection_policy")
  observationId     String?          @map("observation_id") @db.Uuid
  predictionId      String?          @map("prediction_id") @db.Uuid
  responseValue     Float?           @map("response_value")
  status            String
  candidateCount    Int              @map("candidate_count")
  reasons           Json             @default("[]")
  gridCells         GridCell         @relation(fields: [cellId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  metricDefinitions MetricDefinition @relation(fields: [metricKey], references: [id], onDelete: NoAction, onUpdate: NoAction)
  observations      Observation?     @relation(fields: [observationId, releaseId, cellId], references: [id, releaseId, cellId], onDelete: NoAction, onUpdate: NoAction)
  predictions       Prediction?      @relation(fields: [predictionId, releaseId, cellId], references: [id, releaseId, cellId], onDelete: NoAction, onUpdate: NoAction)
  dataReleases      DataRelease      @relation(fields: [releaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([releaseId, cellId, reportingDate, timeBasis, metricKey, selectionPolicy])
  @@index([releaseId, reportingDate, metricKey], map: "daily_activity_period")
  @@map("daily_activity")
  @@schema("firebridge")
}

model Detection {
  id                  BigInt                  @id @default(autoincrement())
  assetId             String                  @map("asset_id") @db.Uuid
  sourceId            String                  @map("source_id")
  nativeRecordKey     String                  @map("native_record_key")
  recordSha256        String                  @map("record_sha256")
  identityKey         String?                 @map("identity_key")
  identityMethod      String                  @map("identity_method")
  processingLevel     String                  @map("processing_level")
  acquiredAt          DateTime                @map("acquired_at") @db.Timestamptz(6)
  geom                Unsupported("geometry")
  confidenceRaw       String?                 @map("confidence_raw")
  confidenceScheme    String                  @map("confidence_scheme")
  typeRaw             String?                 @map("type_raw")
  dayNight            String?                 @map("day_night")
  frpMw               Float?                  @map("frp_mw")
  brightnessBands     Json                    @default("{}") @map("brightness_bands")
  scanKm              Float?                  @map("scan_km")
  trackKm             Float?                  @map("track_km")
