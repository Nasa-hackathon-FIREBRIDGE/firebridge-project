  qualityStatus    String          @map("quality_status")
  derivation       Json            @default("{}")
  assets           Asset           @relation(fields: [assetId, sourceId], references: [id, sourceId], onDelete: NoAction, onUpdate: NoAction)
  weatherLocations WeatherLocation @relation(fields: [locationId, sourceId], references: [id, sourceId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([assetId, locationId, variable, validStart, validEnd])
  @@index([locationId, variable, validStart], map: "weather_values_lookup")
  @@map("weather_values")
  @@schema("firebridge")
}
