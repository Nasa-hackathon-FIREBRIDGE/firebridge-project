{
  "name": "firebridge",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @firebridge/api",
    "dev:worker": "npm run dev --workspace @firebridge/worker",
    "build": "npm run build --workspace @firebridge/api && npm run build --workspace @firebridge/worker && npm run build --workspace @firebridge/database",
    "test": "npm run test --workspace @firebridge/api -- --run && npm run test --workspace @firebridge/worker -- --run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/node": "22.10.2",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "9.15.0",
    "globals": "14.0.0",
    "prettier": "3.4.0",
    "tsx": "4.19.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
