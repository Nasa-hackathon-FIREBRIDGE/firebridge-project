generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["firebridge", "public"]
}

model Source {
  id                                                         String              @id
  name                                                       String
  provider                                                   String
  kind                                                       String
  platform                                                   String?
  instrument                                                 String?
  product                                                    String
  collection                                                 String
  processingStream                                           String              @map("processing_stream")
  documentationUrl                                           String              @map("documentation_url")
  citation                                                   String
  licenseInfo                                                String              @map("license_info")
  nativeResolutionM                                          Float?              @map("native_resolution_m")
  schemaVersion                                              String              @map("schema_version")
  metadata                                                   Json                @default("{}")
  assets                                                     assets[]
  detections                                                 detections[]
  feed_sources                                               feed_sources[]
  model_versions_model_versions_reference_source_idTosources model_versions[]    @relation("model_versions_reference_source_idTosources")
  model_versions_model_versions_source_idTosources           model_versions[]    @relation("model_versions_source_idTosources")
  observations                                               observations[]
  weather_locations                                          weather_locations[]
  weather_summaries                                          weather_summaries[]

  @@map("sources")
  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_explanations {
  id                    String             @id @db.Uuid
  snapshot_id           String             @db.Uuid
  language              String
  question              String
  provider              String
  model_id              String
  prompt_version        String
  tool_contract_version String
  output_json           Json?
  status                String
  validation_report     Json?
  tool_trace_uri        String?
  input_tokens          Int?
  output_tokens         Int?
  cache_key             String             @unique
  created_at            DateTime           @default(now()) @db.Timestamptz(6)
  completed_at          DateTime?          @db.Timestamptz(6)
  evidence_snapshots    evidence_snapshots @relation(fields: [snapshot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  api_jobs              api_jobs[]

  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model analyses {
  id                   String                 @id @db.Uuid
  area_id              String                 @db.Uuid
  release_id           String                 @db.Uuid
  start_date           DateTime               @db.Date
  end_date_exclusive   DateTime               @db.Date
  time_basis           String
  metric_key           String
  grid_id              String?
  selection_policy     String
  weighting_version    String
  baseline_spec        Json?
  weather_policy       Json
  news_policy          Json
  request_spec         Json
  cache_key            String                 @unique
  status               String
  error_code           String?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  completed_at         DateTime?              @db.Timestamptz(6)
  areas                areas                  @relation(fields: [area_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grids                grids?                 @relation(fields: [grid_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  metric_definitions   metric_definitions     @relation(fields: [metric_key], references: [id], onDelete: NoAction, onUpdate: NoAction)
  data_releases        data_releases          @relation(fields: [release_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  analysis_components  analysis_components[]
  analysis_event_links analysis_event_links[]
  api_jobs             api_jobs[]
  calendar_periods     calendar_periods[]
  evidence_snapshots   evidence_snapshots[]
  weather_summaries    weather_summaries[]

  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model analysis_components {
  analysis_id   String         @db.Uuid
  component     String
  release_id    String?        @db.Uuid
  status        String
  reasons       Json           @default("[]")
  analyses      analyses       @relation(fields: [analysis_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  data_releases data_releases? @relation(fields: [release_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([analysis_id, component])
  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model analysis_event_links {
  analysis_id          String          @db.Uuid
  event_id             String          @db.Uuid
  relation             String
  match_method_version String
  temporal_match       Json
  spatial_match        Json
  independence         String
  evidence_note        String
  reviewed_by          String?
  reviewed_at          DateTime?       @db.Timestamptz(6)
  analyses             analyses        @relation(fields: [analysis_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reported_events      reported_events @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([analysis_id, event_id, match_method_version])
  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model api_jobs {
  id                  String           @id @db.Uuid
  kind                String
  analysis_id         String?          @db.Uuid
  explanation_id      String?          @db.Uuid
  requested_by        String
  request_hash        String
  idempotency_key     String
  request_spec        Json
  status              String
  attempt             Int              @default(0)
  lease_expires_at    DateTime?        @db.Timestamptz(6)
  progress            Json             @default("{}")
  result_manifest_uri String?
  result_sha256       String?
  result_byte_size    BigInt?
  expires_at          DateTime?        @db.Timestamptz(6)
  error_code          String?
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  completed_at        DateTime?        @db.Timestamptz(6)
  analyses            analyses?        @relation(fields: [analysis_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ai_explanations     ai_explanations? @relation(fields: [explanation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([requested_by, idempotency_key])
  @@index([status, created_at], map: "jobs_status")
  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model area_cells {
  area_id              String     @db.Uuid
  cell_id              BigInt
  overlap_land_area_m2 Float
  weighting_version    String
  areas                areas      @relation(fields: [area_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grid_cells           grid_cells @relation(fields: [cell_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([area_id, cell_id, weighting_version])
  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model areas {
  id                      String                    @id @db.Uuid
  name                    String
  version                 String
  geom                    Unsupported("geometry")
  geometry_sha256         String
  display_timezone        String
  provenance              String
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  analyses                analyses[]
  area_cells              area_cells[]
  ingestion_subscriptions ingestion_subscriptions[]

  @@unique([geometry_sha256, version])
  @@index([geom], map: "areas_geom_gist", type: Gist)
  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assets {
  id                  String                   @id @db.Uuid
  source_id           String
  native_key          String
  revision            String
  source_url          String
  storage_uri         String
  sha256              String
  byte_size           BigInt
  time_start          DateTime?                @db.Timestamptz(6)
  time_end            DateTime?                @db.Timestamptz(6)
  footprint           Unsupported("geometry")?
  retrieved_at        DateTime                 @db.Timestamptz(6)
  validation_status   String
  metadata            Json                     @default("{}")
  sources             Source                   @relation(fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  detections          detections[]
  fetch_assets        fetch_assets[]
  grids               grids[]
  news_reports        news_reports[]
  observation_assets  observation_assets[]
  quality_issues      quality_issues[]
  release_assets      release_assets[]
  source_availability source_availability[]
  weather_values      weather_values[]

  @@unique([id, source_id])
  @@unique([source_id, native_key, revision, sha256])
  @@index([footprint], map: "assets_footprint_gist", type: Gist)
  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model calendar_periods {
  analysis_id                String   @db.Uuid
  period_start               DateTime @db.Date
  period_end_exclusive       DateTime @db.Date
  resolution                 String
  response_numerator_m2_days Float
  eligible_land_m2_days      Float
  possible_land_m2_days      Float
  response_value             Float?   @default(dbgenerated("(response_numerator_m2_days / NULLIF(eligible_land_m2_days, (0)::double precision))"))
  coverage_fraction          Float?   @default(dbgenerated("(eligible_land_m2_days / possible_land_m2_days)"))
  observed_weight_fraction   Float?
  valid_cell_days            BigInt
  baseline_year_count        Int      @default(0)
  seasonal_percentile        Float?
  uncertainty                Json?
  status                     String
  reasons                    Json     @default("[]")
  analyses                   analyses @relation(fields: [analysis_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([analysis_id, period_start, resolution])
  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model daily_activity {
  release_id         String             @db.Uuid
  cell_id            BigInt
  reporting_date     DateTime           @db.Date
  time_basis         String
  metric_key         String
  selection_policy   String
  observation_id     String?            @db.Uuid
  prediction_id      String?            @db.Uuid
  response_value     Float?
  status             String
  candidate_count    Int
  reasons            Json               @default("[]")
  grid_cells         grid_cells         @relation(fields: [cell_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  metric_definitions metric_definitions @relation(fields: [metric_key], references: [id], onDelete: NoAction, onUpdate: NoAction)
  observations       observations?      @relation(fields: [observation_id, release_id, cell_id], references: [id, release_id, cell_id], onDelete: NoAction, onUpdate: NoAction)
  predictions        predictions?       @relation(fields: [prediction_id, release_id, cell_id], references: [id, release_id, cell_id], onDelete: NoAction, onUpdate: NoAction)
  data_releases      data_releases      @relation(fields: [release_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([release_id, cell_id, reporting_date, time_basis, metric_key, selection_policy])
  @@index([release_id, reporting_date, metric_key], map: "daily_activity_period")
  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model data_partitions {
  id                                                                                String                   @id @db.Uuid
  pipeline_run_id                                                                   String                   @db.Uuid
  kind                                                                              String
  series_key                                                                        String
  partition_key                                                                     String
  support_spec                                                                      Json
  storage_uri                                                                       String
  sha256                                                                            String
  input_manifest_uri                                                                String
  schema_version                                                                    String
  row_count                                                                         BigInt
  serving_complete                                                                  Boolean
  validation_status                                                                 String
  created_at                                                                        DateTime                 @default(now()) @db.Timestamptz(6)
  pipeline_runs                                                                     pipeline_runs            @relation(fields: [pipeline_run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partition_dependencies_partition_dependencies_input_partition_idTodata_partitions partition_dependencies[] @relation("partition_dependencies_input_partition_idTodata_partitions")
  partition_dependencies_partition_dependencies_partition_idTodata_partitions       partition_dependencies[] @relation("partition_dependencies_partition_idTodata_partitions")
  partition_detections                                                              partition_detections[]
  release_partitions                                                                release_partitions[]

  @@unique([id, series_key, partition_key])
  @@unique([series_key, partition_key, sha256])
  @@index([series_key, partition_key, created_at(sort: Desc)], map: "partitions_key")
  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model data_releases {
  id                                                             String                @id @db.Uuid
  name                                                           String                @unique
  status                                                         String
  stream                                                         String
  code_version                                                   String
  config                                                         Json
  config_sha256                                                  String
  manifest_uri                                                   String
  parent_release_id                                              String?               @db.Uuid
  dataset_kind                                                   String
  scope_key                                                      String
  observation_cutoff                                             DateTime              @db.Timestamptz(6)
  validation_report_uri                                          String?
  created_at                                                     DateTime              @default(now()) @db.Timestamptz(6)
  published_at                                                   DateTime?             @db.Timestamptz(6)
  analyses                                                       analyses[]
  analysis_components                                            analysis_components[]
  daily_activity                                                 daily_activity[]
  data_releases                                                  data_releases?        @relation("data_releasesTodata_releases", fields: [parent_release_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_data_releases                                            data_releases[]       @relation("data_releasesTodata_releases")
  evaluations                                                    evaluations[]
  feature_sets                                                   feature_sets[]
  matched_pairs                                                  matched_pairs[]
  observations                                                   observations[]
  pipeline_runs                                                  pipeline_runs[]
  predictions                                                    predictions[]
  release_aliases                                                release_aliases[]
  release_assets                                                 release_assets[]
  release_changes_release_changes_from_release_idTodata_releases release_changes[]     @relation("release_changes_from_release_idTodata_releases")
  release_changes_release_changes_to_release_idTodata_releases   release_changes[]     @relation("release_changes_to_release_idTodata_releases")
  release_partitions                                             release_partitions[]

  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detections {
  id                   BigInt                  @id @default(autoincrement())
  asset_id             String                  @db.Uuid
  source_id            String
  native_record_key    String
  record_sha256        String
  identity_key         String?
  identity_method      String
  processing_level     String
  acquired_at          DateTime                @db.Timestamptz(6)
  geom                 Unsupported("geometry")
  confidence_raw       String?
  confidence_scheme    String
  type_raw             String?
  day_night            String?
  frp_mw               Float?
  brightness_bands     Json                    @default("{}")
  scan_km              Float?
  track_km             Float?
  cross_track_sample   Int?
  native_fields        Json                    @default("{}")
  assets               assets                  @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sources              Source                  @relation(fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partition_detections partition_detections[]

  @@unique([asset_id, native_record_key])
  @@unique([source_id, record_sha256])
  @@index([geom], map: "detections_geom_gist", type: Gist)
  @@index([source_id, acquired_at], map: "detections_source_time")
  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model evaluations {
  id                      String         @id @db.Uuid
  model_id                String         @db.Uuid
  release_id              String         @db.Uuid
  experiment              String
  slice_key               String
  split_manifest_uri      String
  sample_count            BigInt
  positive_count          BigInt
  independent_block_count Int
  metrics                 Json
  baseline_metrics        Json
  uncertainty_method      String?
  report_uri              String
  model_versions          model_versions @relation(fields: [model_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  data_releases           data_releases  @relation(fields: [release_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([model_id, release_id, experiment, slice_key])
  @@schema("firebridge")
}

model evidence_snapshots {
  id              String            @id @db.Uuid
  analysis_id     String            @db.Uuid
  schema_version  String
  evidence_json   Json
  sha256          String
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  ai_explanations ai_explanations[]
  analyses        analyses          @relation(fields: [analysis_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([analysis_id, sha256])
  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model feature_sets {
  id                 String           @id @db.Uuid
  release_id         String           @db.Uuid
  version            String
  artifact_uri       String
  sha256             String
  feature_contract   Json
  split_manifest_uri String
  split_sha256       String
  row_count          BigInt
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  data_releases      data_releases    @relation(fields: [release_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  model_versions     model_versions[]

  @@schema("firebridge")
}

model feed_sources {
  feed_id             String
  source_id           String
  selector            Json
  ingestion_feeds     ingestion_feeds       @relation(fields: [feed_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sources             Source                @relation(fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source_availability source_availability[]

  @@id([feed_id, source_id])
  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model fetch_assets {
  fetch_run_id String     @db.Uuid
  asset_id     String     @db.Uuid
  role         String
  page_key     String
  assets       assets     @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fetch_runs   fetch_runs @relation(fields: [fetch_run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([fetch_run_id, asset_id, role, page_key])
  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model fetch_runs {
  id                      String                  @id @db.Uuid
  subscription_id         String                  @db.Uuid
  pipeline_run_id         String?                 @db.Uuid
  request_key             String
  attempt                 Int
  query_start             DateTime                @db.Timestamptz(6)
  query_end_exclusive     DateTime                @db.Timestamptz(6)
  query_basis             String
  sanitized_request       Json
  status                  String
  enumeration_complete    Boolean                 @default(false)
  page_count              Int                     @default(0)
  record_count            BigInt?
  started_at              DateTime?               @db.Timestamptz(6)
  completed_at            DateTime?               @db.Timestamptz(6)
  max_observation_at      DateTime?               @db.Timestamptz(6)
  http_status             Int?
  retry_after             DateTime?               @db.Timestamptz(6)
  error_code              String?
  fetch_assets            fetch_assets[]
  pipeline_runs           pipeline_runs?          @relation(fields: [pipeline_run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ingestion_subscriptions ingestion_subscriptions @relation(fields: [subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ingestion_checkpoints   ingestion_checkpoints[]
  ingestion_gaps          ingestion_gaps[]

  @@unique([subscription_id, request_key, attempt])
  @@index([subscription_id, started_at(sort: Desc)], map: "fetch_runs_recent")
  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model grid_cells {
  id             BigInt                  @id @default(autoincrement())
  grid_id        String
