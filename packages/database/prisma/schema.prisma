/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ingestion_feeds {
  id                      String                    @id
  provider                String
  adapter                 String
  adapter_version         String
  endpoint_template       String
  credential_ref          String?
  rate_limit_group        String
  capability_spec         Json
  state                   String
  verified_at             DateTime?                 @db.Timestamptz(6)
  feed_sources            feed_sources[]
  ingestion_subscriptions ingestion_subscriptions[]

  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ingestion_gaps {
  id                      String                  @id @db.Uuid
  subscription_id         String                  @db.Uuid
  gap_start               DateTime                @db.Timestamptz(6)
  gap_end_exclusive       DateTime                @db.Timestamptz(6)
  kind                    String
  status                  String
  discovered_at           DateTime                @db.Timestamptz(6)
  last_attempt_at         DateTime?               @db.Timestamptz(6)
  retry_after             DateTime?               @db.Timestamptz(6)
  resolved_by_run_id      String?                 @db.Uuid
  evidence                Json
  fetch_runs              fetch_runs?             @relation(fields: [resolved_by_run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ingestion_subscriptions ingestion_subscriptions @relation(fields: [subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, retry_after], map: "gaps_pending")
  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ingestion_subscriptions {
  id                    String                  @id @db.Uuid
  feed_id               String
  area_id               String                  @db.Uuid
  scope_key             String
  mode                  String
  interval_seconds      Int
  overlap_seconds       Int
  history_start         DateTime                @db.Timestamptz(6)
  fixed_end_exclusive   DateTime?               @db.Timestamptz(6)
  request_config        Json
  config_sha256         String
  enabled               Boolean                 @default(false)
  next_due_at           DateTime?               @db.Timestamptz(6)
  lease_owner           String?
  lease_expires_at      DateTime?               @db.Timestamptz(6)
  fetch_runs            fetch_runs[]
  ingestion_checkpoints ingestion_checkpoints[]
