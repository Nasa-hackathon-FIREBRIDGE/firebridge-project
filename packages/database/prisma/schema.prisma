  @@unique([grid_id, grid_x, grid_y])
  @@index([geom], map: "grid_cells_geom_gist", type: Gist)
  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model grids {
  id                 String                  @id
  version            String
  projection_srid    Int
  cell_size_m        Float
  origin_x_m         Float
  origin_y_m         Float
  supported_extent   Unsupported("geometry")
  land_mask_asset_id String                  @db.Uuid
  construction_spec  Json
  analyses           analyses[]
  grid_cells         grid_cells[]
  assets             assets                  @relation(fields: [land_mask_asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("firebridge")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ingestion_checkpoints {
  subscription_id         String                  @db.Uuid
  stage                   String
  cursor_basis            String
