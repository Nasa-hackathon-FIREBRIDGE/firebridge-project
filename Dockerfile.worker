FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
COPY apps/worker/package*.json ./apps/worker/
COPY apps/api/package*.json ./apps/api/
COPY packages ./packages

RUN npm ci

COPY . .

RUN DATABASE_URL="postgresql://postgres:postgres@localhost:5432/firebridge?schema=firebridge" npm run build --workspace @firebridge/worker

CMD ["npm", "run", "start", "--workspace", "@firebridge/worker"]
