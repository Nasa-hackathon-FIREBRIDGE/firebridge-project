{
  "apiVersion": "v1",
  "basePath": "/api/v1",
  "resources": [
    "health",
    "catalog",
    "sources",
    "releases",
    "updates",
    "areas",
    "analyses",
    "detections",
    "tiles",
    "cells",
    "weather",
    "reports",
    "provenance",
    "explanations",
    "exports",
    "jobs",
    "admin"
  ],
  "endpoints": {
    "health": [
      "GET /health/live",
      "GET /health/ready"
    ],
    "catalog": [
      "GET /catalog",
      "GET /catalog/:id"
    ],
    "sources": [
      "GET /sources",
      "POST /sources"
    ],
    "releases": [
      "GET /releases",
      "GET /releases/:id"
    ],
    "updates": [
      "GET /updates",
      "POST /updates"
    ],
    "areas": [
      "GET /areas",
      "POST /areas",
      "GET /areas/:areaId"
    ],
    "analyses": [
      "GET /analyses",
      "POST /analyses",
      "GET /analyses/:id",
      "GET /analyses/:id/tiles/:layer/:z/:x/:y.mvt",
      "POST /analyses/:id/exports"
    ],
    "detections": [
      "GET /detections",
      "POST /detections"
    ],
    "tiles": [
      "GET /tiles",
      "GET /tiles/:tileId"
    ],
    "cells": [
      "GET /cells",
      "GET /cells/:cellId"
    ],
    "weather": [
      "GET /weather",
      "GET /weather/:locationId"
    ],
    "reports": [
      "GET /reports",
      "POST /reports"
    ],
    "provenance": [
      "GET /provenance",
      "GET /provenance/:id"
    ],
    "explanations": [
      "GET /explanations",
      "POST /explanations"
    ],
    "exports": [
      "GET /exports",
      "POST /exports"
    ],
    "jobs": [
      "GET /jobs",
      "GET /jobs/:jobId",
      "GET /jobs/:id/download"
    ],
    "admin": [
      "GET /admin/status",
      "POST /admin/refresh"
    ]
  },
  "implementationStatus": "partially_implemented_see_docs_API_AUDIT"
}
